{
  "name": "siralama-defteri",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "bash supabase/test/calistir.sh",
    "apple:anahtar": "node scripts/apple-gizli-anahtar.mjs",
    "mobil": "NEXT_PUBLIC_MOBIL=1 next build && cap sync",
    "ios": "NEXT_PUBLIC_MOBIL=1 next build && cap sync ios && cap open ios",
    "uygulama:gorseller": "node scripts/uygulama-gorselleri.mjs && npx --yes @capacitor/assets@3.0.5 generate --ios",
    "ios:testflight": "npm run mobil && rm -rf build/ios && xcodebuild archive -project ios/App/App.xcodeproj -scheme App -configuration Release -destination generic/platform=iOS -archivePath build/ios/SiralamaDefteri.xcarchive -allowProvisioningUpdates -quiet && xcodebuild -exportArchive -archivePath build/ios/SiralamaDefteri.xcarchive -exportOptionsPlist ios/App/ExportOptions.plist -exportPath build/ios/disari -allowProvisioningUpdates"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
